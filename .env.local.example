# Copy to .env.local and fill from `supabase start` output (local) or your Supabase project settings.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. NEVER prefix with NEXT_PUBLIC_, never import in a 'use client' file.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app, used to build the OAuth redirect. Local default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
